# Backend
PORT=3000

# MySQL (used by the mysql container AND passed to backend by compose)
MYSQL_ROOT_PASSWORD=MyRootPass123!
MYSQL_DATABASE=hotel_pms
MYSQL_USER=pms_user
MYSQL_PASSWORD=MyDbPass123!

# JWT — generate long random strings (see below)
ACCESS_TOKEN_SECRET=REPLACE_WITH_LONG_RANDOM_STRING_1
REFRESH_TOKEN_SECRET=REPLACE_WITH_LONG_RANDOM_STRING_2

# Cloudinary — leave blank to boot; needed only for image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend (baked into the React build via Docker build arg)
VITE_API_URL=http://localhost:3000/api/v1